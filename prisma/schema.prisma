datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  USER
}

enum DocumentStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(ADMIN)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  bookmarks    Bookmark[]

  @@map("users")
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  icon        String?    @default("Book")
  order       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  documents   Document[]

  @@map("categories")
}

model Tag {
  id        String        @id @default(cuid())
  name      String        @unique
  slug      String        @unique
  createdAt DateTime      @default(now())
  documents DocumentTag[]

  @@map("tags")
}

model Document {
  id            String         @id @default(cuid())
  title         String
  slug          String         @unique
  description   String?
  author        String?        @default("Unknown")
  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  fileUrl       String
  storageKey    String
  coverUrl      String?
  mimeType      String         @default("application/pdf")
  fileSize      Int            @default(0)
  pageCount     Int            @default(1)
  language      String?        @default("en")
  status        DocumentStatus @default(READY)
  isPublished   Boolean        @default(true)
  allowDownload Boolean        @default(true)
  isFeatured    Boolean        @default(false)
  viewCount     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  tags          DocumentTag[]
  bookmarks     Bookmark[]
  viewLogs      ViewLog[]

  @@index([categoryId])
  @@index([isPublished])
  @@index([isFeatured])
  @@index([createdAt])
  @@map("documents")
}

model DocumentTag {
  documentId String
  tagId      String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([documentId, tagId])
  @@map("document_tags")
}

model Bookmark {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientToken String?
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  pageNumber  Int      @default(1)
  createdAt   DateTime @default(now())

  @@index([documentId])
  @@index([clientToken])
  @@map("bookmarks")
}

model ViewLog {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  viewedAt   DateTime @default(now())
  ipHash     String?
  userAgent  String?

  @@index([documentId])
  @@index([viewedAt])
  @@map("view_logs")
}
